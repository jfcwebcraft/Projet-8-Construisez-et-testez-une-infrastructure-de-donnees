# Copier ce fichier vers .env et renseigner des valeurs propres à votre poste.
# Le fichier .env réel ne doit jamais être versionné (voir .gitignore).

# --- Base PostgreSQL analytique (destination Airbyte / source DBT) ---
DWH_POSTGRES_USER=weather_admin
DWH_POSTGRES_PASSWORD=change_me
DWH_POSTGRES_DB=weather_dwh
DWH_POSTGRES_PORT=5434

# --- Airbyte OSS (version Docker Compose 0.63.14) ---
AIRBYTE_VERSION=0.63.14
AIRBYTE_DATABASE_USER=airbyte_internal
AIRBYTE_DATABASE_PASSWORD=change_me
AIRBYTE_DATABASE_URL=jdbc:postgresql://airbyte_db:5432/airbyte
AIRBYTE_WEBAPP_PORT=8000
AIRBYTE_BASIC_AUTH_USERNAME=airbyte
AIRBYTE_BASIC_AUTH_PASSWORD=change_me

# --- Chemins internes Airbyte (valeurs par défaut, ne pas modifier sauf besoin spécifique) ---
CONFIG_ROOT=/data
WORKSPACE_ROOT=/tmp/workspace
LOCAL_ROOT=/tmp/airbyte_local
LOCAL_DOCKER_MOUNT=airbyte_local_root
WORKSPACE_DOCKER_MOUNT=airbyte_workspace
HACK_LOCAL_ROOT_PARENT=/tmp
LOG_LEVEL=INFO

# --- AWS (utilisé par les scripts d'infrastructure, phase de déploiement cloud) ---
AWS_REGION=eu-west-3
AWS_RDS_INSTANCE_IDENTIFIER=weather-dwh-rds
AWS_RDS_MASTER_USERNAME=weather_admin
AWS_RDS_MASTER_PASSWORD=change_me
